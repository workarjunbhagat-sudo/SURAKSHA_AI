# Copy this file to .env. Never commit .env or API keys.
# Local FastAPI service URL; Streamlit falls back to local inference if unavailable.
SURAKSHA_API_URL=http://127.0.0.1:8000

# Optional local-development API key. If set, send this header to /v1 endpoints.
# Use a long random secret before exposing the API beyond localhost.
SURAKSHA_API_KEY=replace-with-a-long-random-local-secret

# Optional database path (metadata-only, opt-in history).
SURAKSHA_DB_PATH=data/suraksha_events.sqlite3

# Optional model name for local Ollama fallback.
SURAKSHA_OLLAMA_MODEL=llama3.2:3b
